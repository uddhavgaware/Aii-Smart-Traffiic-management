# ============================================================
# AI-Based Intelligent Traffic Management System
# Root Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN REAL VALUES
# NEVER COMMIT .env TO VERSION CONTROL
# ============================================================

# ---- Application ----
JUNCTION_ID=junction_001
DEMO_MODE=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_TURN_SERVER=turn:your-turn-server.com:3478
VITE_STUN_SERVER=stun:stun.l.google.com:19302

# ---- Backend Database ----
DATABASE_URL=postgresql+asyncpg://smarttraffic:changeme@localhost:5432/smarttraffic
POSTGRES_USER=smarttraffic
POSTGRES_PASSWORD=changeme
POSTGRES_DB=smarttraffic

# ---- Redis ----
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ---- Security ----
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- MQTT (ESP32 Communication) ----
MQTT_BROKER=your-mqtt-broker.com
MQTT_PORT=8883
MQTT_USERNAME=traffic_system
MQTT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MQTT_USE_TLS=true
MQTT_TOPIC_PREFIX=smarttraffic/junction_001
MQTT_QOS=1

# ---- ML Inference Service ----
ML_INFERENCE_URL=http://localhost:8001
ML_API_KEY=REPLACE_WITH_ML_API_KEY

# ---- WebRTC / TURN ----
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=REPLACE_WITH_TURN_USERNAME
TURN_CREDENTIAL=REPLACE_WITH_TURN_CREDENTIAL
STUN_SERVER_URL=stun:stun.l.google.com:19302

# ---- Signal Timing Defaults (seconds) ----
MIN_GREEN_TIME=15
MAX_GREEN_TIME=120
YELLOW_TIME=3
ALL_RED_TIME=2
MAX_WAIT_TIME=180
DEFAULT_NORMAL_GREEN=30
DEFAULT_HEAVY_GREEN=60
DEFAULT_JAM_GREEN=90

# ---- Performance ----
CAMERA_RESOLUTION=720p
INFERENCE_FPS_PER_CAMERA=5
GPU_DEVICE=0
USE_FP16=true

# ---- Admin User (for initial setup) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@smarttraffic.local
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
