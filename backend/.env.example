# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/smarttraffic
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# MQTT
MQTT_BROKER=your-mqtt-broker.com
MQTT_PORT=8883
MQTT_USERNAME=traffic_system
MQTT_PASSWORD=your-mqtt-password
MQTT_USE_TLS=true
MQTT_TOPIC_PREFIX=smarttraffic/junction1

# ML Inference
ML_INFERENCE_URL=http://localhost:8001
ML_API_KEY=your-ml-service-key

# WebRTC Signaling
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=your-turn-user
TURN_CREDENTIAL=your-turn-credential
STUN_SERVER_URL=stun:stun.l.google.com:19302

# App
CORS_ORIGINS=["http://localhost:3000","https://your-domain.com"]
DEMO_MODE=false
JUNCTION_ID=junction_001
